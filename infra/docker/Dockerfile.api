FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ARG VERSION=development
ARG REVISION=unknown
ARG SOURCE=https://github.com/francescoveryra-dot/deepscout

LABEL org.opencontainers.image.title="DeepScout API" \
    org.opencontainers.image.description="DeepScout API, research worker, and database migration runtime" \
    org.opencontainers.image.source="$SOURCE" \
    org.opencontainers.image.version="$VERSION" \
    org.opencontainers.image.revision="$REVISION" \
    org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" --uid 10001 deepscout \
    && pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY libs/core/pyproject.toml libs/core/pyproject.toml
COPY libs/providers/pyproject.toml libs/providers/pyproject.toml
COPY libs/research/pyproject.toml libs/research/pyproject.toml
COPY libs/persistence/pyproject.toml libs/persistence/pyproject.toml
COPY libs/evaluation/pyproject.toml libs/evaluation/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml

COPY libs/core/src libs/core/src
COPY libs/providers/src libs/providers/src
COPY libs/research/src libs/research/src
COPY libs/persistence/src libs/persistence/src
COPY libs/persistence/alembic.ini libs/persistence/alembic.ini
COPY libs/persistence/alembic libs/persistence/alembic
COPY libs/evaluation/src libs/evaluation/src
COPY apps/api/src apps/api/src
COPY infra/docker/entrypoint.sh /entrypoint.sh

RUN uv sync --all-packages --no-dev \
    && chmod +x /entrypoint.sh \
    && chown -R deepscout:deepscout /app

USER deepscout
EXPOSE 8000
ENV APP_ENV=production \
    APP_DEBUG=false \
    API_HOST=0.0.0.0 \
    RATE_LIMIT_ENABLED=true \
    DEEPSCOUT_VERSION="$VERSION" \
    GIT_SHA="$REVISION"
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD python -c "import os,sys,urllib.request; sys.exit(0) if os.environ.get('DEEPSCOUT_PROCESS_ROLE')=='worker' else urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8000'), timeout=4).close()"

ENTRYPOINT ["/entrypoint.sh"]
