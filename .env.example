# DeepScout — copy to .env and fill locally. Never commit real secrets.

# --- LLM providers (multi-provider; swap without code changes) ---
LLM_PROVIDER=google
LLM_MODEL=
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web search (adapter-based; Tavily is default v1 adapter) ---
TAVILY_API_KEY=

# --- LangSmith (tracing + evaluations) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepscout-dev
# Required for organization-scoped LangSmith service keys (Settings > General > Workspace ID)
LANGSMITH_WORKSPACE_ID=
# Use https://eu.api.smith.langchain.com if your LangSmith account is on eu.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Application ---
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SMOKE_AGENT=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MUTATING_MAX=20
RATE_LIMIT_WINDOW_S=60
MAX_REQUEST_BYTES=1000000

# --- Database ---
DATABASE_URL=postgresql+psycopg://deepscout:deepscout@localhost:5432/deepscout

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Research budgets (defaults; overridable per run in Phase 1+) ---
RESEARCH_MAX_ITERATIONS=5
RESEARCH_MAX_WALL_TIME_S=900
RESEARCH_MAX_SOURCES=40
RESEARCH_MAX_TOOL_CALLS=80
