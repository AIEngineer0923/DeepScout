# DeepScout — copy to .env and fill locally. Never commit real secrets.

# --- LLM providers (multi-provider; swap without code changes) ---
LLM_PROVIDER=google
LLM_MODEL=
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_ROUTER_ENABLED=true
CONTEXTUAL_RETRIEVAL_ENABLED=true
# deterministic (default) | cross_encoder (requires sentence-transformers)
RERANKER_MODE=deterministic

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web search (adapter-based; Tavily is default v1 adapter) ---
TAVILY_API_KEY=

# --- LangSmith (opt-in; research text is sent when tracing is true) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepscout-dev
# Required for organization-scoped LangSmith service keys (Settings > General > Workspace ID)
LANGSMITH_WORKSPACE_ID=
# Use https://eu.api.smith.langchain.com if your LangSmith account is on eu.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Application ---
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SMOKE_AGENT=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MUTATING_MAX=20
RATE_LIMIT_WINDOW_S=60
MAX_REQUEST_BYTES=1000000

# --- Database ---
DATABASE_URL=postgresql+psycopg://deepscout:deepscout@localhost:5432/deepscout
# Direct/session Postgres URL if DATABASE_URL is a transaction pooler (LISTEN cannot use those).
DATABASE_LISTEN_URL=
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=16

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Research budgets (defaults; overridable per run in Phase 1+) ---
RESEARCH_MAX_ITERATIONS=5
RESEARCH_MAX_WALL_TIME_S=900
RESEARCH_MAX_SOURCES=40
RESEARCH_MAX_TOOL_CALLS=80

# --- Human-in-the-loop (operational approvals; MODE A local operator) ---
HITL_ENABLED=true
HITL_BUDGET_EXTENSION_REQUIRES_REVIEW=true
HITL_DEFAULT_REVIEW_EXPIRY_HOURS=72

# --- Agent runtime ---
AGENT_MAX_DELEGATION_DEPTH=1
AGENT_MAX_REPLANS=1
AGENT_MAX_NEW_TASKS_PER_REPLAN=3
AGENT_MAX_TOTAL_WORKERS=12
AGENT_SKILLS_AUTO=true
CONTEXT_COMPACTION_CHAR_LIMIT=12000
PLANNER_PROMPT_VERSION=2

# --- Deployment mode: local (default, no login) or hosted (auth mandatory) ---
DEEPSCOUT_DEPLOYMENT_MODE=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HOSTED_MAX_CONCURRENT_RUNS_PER_USER=2
HOSTED_MAX_MONITORS_PER_USER=5

